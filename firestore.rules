rules_version = '2';
// Better HSC Papers — paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['jamestanudji@gmail.com'];
    }
    function owns(data) { return signedIn() && data.uid == request.auth.uid; }
    function course(d) { return d.course in ['standard2', 'advanced', 'extension1', 'extension2', 'physics', 'chemistry', 'biology']; }
    // typed question text, or a photo/screenshot of the question (or both)
    function textOk(d) {
      return d.question is string && d.question.size() < 20000
        && (d.question.size() > 0 || (d.images is list && d.images.size() > 0));
    }

    // ticks and flags a user has made — private
    match /progress/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // flagged questions — anyone signed in can flag; only admins can see and manage them
    match /flags/{id} {
      allow create: if owns(request.resource.data) && request.resource.data.qid is string
        && request.resource.data.note.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    // full community questions — public, live straight away
    match /submissions/{id} {
      allow read: if true;
      allow create: if owns(request.resource.data) && course(request.resource.data) && textOk(request.resource.data);
      allow update: if isAdmin() || (owns(resource.data) && request.resource.data.uid == resource.data.uid
        && course(request.resource.data) && textOk(request.resource.data));
      allow delete: if isAdmin() || owns(resource.data);
    }

    // question-only submissions waiting for the daily task to add solutions (public so the task can read them)
    match /queue/{id} {
      allow read: if true;
      allow create: if owns(request.resource.data) && course(request.resource.data) && textOk(request.resource.data);
      allow update: if isAdmin() || (owns(resource.data) && request.resource.data.uid == resource.data.uid
        && course(request.resource.data) && textOk(request.resource.data));
      allow delete: if isAdmin() || owns(resource.data);
    }

    // whole papers / practice exams uploaded as photos or PDFs, for the daily task to index (public so the task can read them)
    match /paperUploads/{id} {
      allow read: if true;
      allow create: if owns(request.resource.data) && course(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.files is list && request.resource.data.files.size() > 0 && request.resource.data.files.size() <= 60;
      allow update: if isAdmin() || (owns(resource.data) && request.resource.data.uid == resource.data.uid && course(request.resource.data));
      allow delete: if isAdmin() || owns(resource.data);
      match /chunks/{cid} {
        allow read: if true;
        allow create, update: if signedIn() && get(/databases/$(database)/documents/paperUploads/$(id)).data.uid == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() <= 800000;
        allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/paperUploads/$(id)).data.uid == request.auth.uid);
      }
    }

    // admin edits / deletions of any question on the site
    match /overrides/{qid} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
